# Copy to .env and fill in. NEVER commit .env and never add these to Vite (VITE_*) variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=18

COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TIMEOUT_SECONDS=30
COPERNICUS_MAX_CLOUD_COVER_PERCENT=80

OPEN_METEO_TIMEOUT_SECONDS=12

# Comma-separated origins allowed to call FastAPI directly.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
